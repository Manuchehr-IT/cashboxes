# App
APP__ENVIRONMENT=local
APP__ALLOWED_ORIGINS=["http://localhost:5173"]
APP__ALLOWED_HOSTS=["localhost"]

APP__TITLE=Cashboxes
APP__LANGUAGES=["ru"]
APP__DEFAULT_LANGUAGE=ru

# Database
DATABASE__NAME=cashboxes
DATABASE__USER=cashboxes
DATABASE__PASSWORD=change-me
DATABASE__HOST=postgres
DATABASE__PORT=5432

# Redis
REDIS__HOST=redis
REDIS__PORT=6379

# Traefik — прод (docker-compose.yml): реальный домен, общий внешний Traefik (traefik-infra).
# LAN (docker-compose.lan.yml): IP(-а) сервера в локальной сети, свой Traefik без TLS (см. README).
# Значение подставляется в Host(...) как есть, включая обратные кавычки — один хост:
#   DOMAIN=`example.com`
# несколько (например внутренний+внешний IP на LAN) — через запятую, каждый в кавычках:
#   DOMAIN=`10.250.10.135`, `185.105.230.224`
DOMAIN=`example.com`

# LAN deploy only (docker-compose.lan.yml) — порт своего Traefik на хосте, по умолчанию
# подходит большинству случаев
FRONTEND_PORT=5173
