# Redis
REDIS__HOST=redis
REDIS__PORT=6379

# Local
VITE_API_URL=http://localhost:8000

# Traefik (production only, used by docker-compose.yml labels)
BACKEND_DOMAIN=api.example.com
FRONTEND_DOMAIN=example.com
