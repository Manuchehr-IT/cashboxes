# Stage 1
FROM node:20-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

# ARG/ENV идут после npm ci намеренно: значение VITE_API_URL меняется чаще, чем
# зависимости, а Docker сбрасывает кэш у всех слоёв после изменившегося — если бы
# ARG стоял раньше npm ci, смена URL заново скачивала бы все npm-пакеты.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

COPY . .

RUN npm run build

# Stage 2: serve build
FROM node:20-slim

WORKDIR /app

COPY --from=builder /app/dist ./dist

RUN npm install -g serve

CMD ["sh", "-c", "serve -s dist -l 80"]
